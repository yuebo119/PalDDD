<Project Sdk="Microsoft.NET.Sdk">

<!-- Core 层测试 — 实体/值对象/SmartEnum/源生成器 -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- ITM-810（2026-09-19）：本项目依赖 MessageRegistryGenerator 源生成产物
        （PalDDD.Generated），而 dotnet format 的分析上下文不加载生成物——引用
         生成命名空间的 using（PalDDD.Generated/PalDDD.Serialization）被 IDE0005
         误判 unnecessary（CI run 101/102/104 三次实证，行级压制会打地鼠）。
         编译正确性由 TreatWarningsAsErrors + Build 步骤守护，IDE0005 卫生提示
         在本项目失效为可接受代价；其余 15 项目保持检查。 -->
    <NoWarn>$(NoWarn);IDE0005</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\PalDDD.Serialization\PalDDD.Serialization.csproj" />
    <ProjectReference Include="..\..\src\PalDDD.Core\PalDDD.Core.csproj" />
    <ProjectReference Include="..\..\src\PalDDD.CQRS\PalDDD.CQRS.csproj" />
    <ProjectReference Include="..\..\src\PalDDD.DependencyInjection\PalDDD.DependencyInjection.csproj" />
    <ProjectReference Include="..\..\src\PalDDD.EventLog\PalDDD.EventLog.csproj" />
    <ProjectReference Include="..\..\src\PalDDD.Idempotency\PalDDD.Idempotency.csproj" />
    <ProjectReference Include="..\..\src\PalDDD.Messaging\PalDDD.Messaging.csproj" />
    <ProjectReference Include="..\..\src\PalDDD.Projections\PalDDD.Projections.csproj" />
    <ProjectReference Include="..\..\src\PalDDD.Projections.EventLog\PalDDD.Projections.EventLog.csproj" />
    <ProjectReference Include="..\..\src\PalDDD.Serialization.Evolution\PalDDD.Serialization.Evolution.csproj" />
    <ProjectReference Include="..\..\src\PalDDD.Transactions\PalDDD.Transactions.csproj" />
    <!-- 2026-09-25：PublicApiSnapshotTests 及其 Snapshots/ 迁至 PalDDD.Integration.Tests——
         快照覆盖扩展（decision-2026-09-25-publicapi-snapshot-scope-expansion）需引用数据面
         适配层程序集，而本测试项目作为 Domain 测试被 ArchitectureBoundaryTests 禁止引用
         Infra 实现（DomainTests_DoNotReferenceInfrastructureImplementations 实测拦截）。
         Integration.Tests 在守卫白名单内，为快照宿主的正确归属 -->
    <ProjectReference Include="..\PalDDD.Testing\PalDDD.Testing.csproj" />
    <ProjectReference Include="..\..\src\PalDDD.Core.SourceGen\PalDDD.Core.SourceGen.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
    <PackageReference Include="TUnit" />
    <PackageReference Include="FsCheck" />
    <PackageReference Include="TUnit.FsCheck" />
  </ItemGroup>

</Project>
