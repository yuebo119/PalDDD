<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <IsPackable>true</IsPackable>
    <Description>PalDDD strategic DDD compile-time code fixes (PDDD008/PDDD010/PDDD013/PDDD015).</Description>
    <IsRoslynComponent>true</IsRoslynComponent>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <DevelopmentDependency>true</DevelopmentDependency>
    <IsAotCompatible>false</IsAotCompatible>
    <IsTrimmable>false</IsTrimmable>
    <!-- v8 评审 P2-3 移除 SuppressDependenciesWhenPacking：抑制使 nuspec 零依赖——独立安装
         CodeFixes 包时 Roslyn 缺 PalDDD.Analyzers 程序集，5 个 fix provider 全部静默失效
         （1.1.0 nupkg 实证）。ProjectReference 打包自动声明依赖（版本=被引项目版本，Base 元包
         ITM-128 先例），独立安装时 NuGet 拉入 Analyzers 包，fix 可用。 -->
    <NoWarn>$(NoWarn);RS1035;RS2008;CS1591;NU5128</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\PalDDD.Analyzers\PalDDD.Analyzers.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <None Include="$(OutputPath)\$(AssemblyName).dll" Pack="true" PackagePath="analyzers/dotnet/cs" />
  </ItemGroup>

</Project>
