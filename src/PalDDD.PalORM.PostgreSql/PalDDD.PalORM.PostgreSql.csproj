<Project Sdk="Microsoft.NET.Sdk">

  <!--
    PalDDD.PalORM.PostgreSql — PostgreSQL 方言包（固化 PostgreSqlProvider）
    ════════════════════════════════════════════════════════════
    定位：固化 PalORM.PostgreSql 的 PostgreSqlProvider 类型，为 DI 容器提供单参数开放泛型类。
    PG 支持 RETURNING 子句 —— TProvider.SupportsReturningClause=true（单语句原子租约路径）。

    本包当前仅含 Store 中间固化类 + DI 扩展。
    方言特有能力（LISTEN/NOTIFY、JsonbExtensions、Auditor、SoftDelete、Sharding、ReadWriteRouter）
    将逐步从 PalDDD.Dapper.PostgreSql 迁移（后续 PR）。
  -->

  <PropertyGroup>
    <RootNamespace>PalDDD.PalORM.PostgreSql</RootNamespace>
    <IsAotCompatible>true</IsAotCompatible>
    <IsTrimmable>true</IsTrimmable>
    <Description>Pal.DDD PalORM PostgreSQL 适配包（AOT + 源生成 + RETURNING/COPY）</Description>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- IL3058（三十五轮 B1 补理由）：方言 connector 包（MySqlConnector/Npgsql/Microsoft.Data.Sqlite）
         传递的 AOT 分析器警告噪声；IsAotCompatible=true 声明基于核心包 PublishAot 验证，
         方言级 AOT publish 仅 Sqlite 样例经 CI aot-verify 验证（MySql/PG 为缺口，docs/aot.md 已声明） -->
    <NoWarn>$(NoWarn);CS1591;CS1573;CA2007;IL3058</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="PalORM.PostgreSql" />
    <PackageReference Include="PalORM.Core" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PalDDD.PalORM\PalDDD.PalORM.csproj" />
  </ItemGroup>

</Project>
