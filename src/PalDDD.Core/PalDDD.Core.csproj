<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>PalDDD.Core</RootNamespace>
    <!-- Core exposes compact framework primitives; XML docs and selected framework-design warnings are tracked at project scope. -->
    <NoWarn>$(NoWarn);CS1591;CA1040;CA1000;CA1711;CA2225;CA1030;CA1305;CA1308;CA1508;CA1822</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ByteAether.Ulid" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="PalDDD.Core.Tests"/>
    <InternalsVisibleTo Include="PalDDD.DependencyInjection"/>
    <!-- 2026-10-21 R7：日志门面注册下移后，Transactions 的组件级入口也要能调用内部注册方法。 -->
    <InternalsVisibleTo Include="PalDDD.Transactions"/>
    <!-- 2026-10-21 R8：PG LISTEN/NOTIFY 通知器是 R7 家族成员，组件级注册复用同一门面注册点。 -->
    <InternalsVisibleTo Include="PalDDD.Dapper.PostgreSql"/>
    <!-- R7：StructuredLoggingTests 直接构造门面适配器验证结构化转发。 -->
    <InternalsVisibleTo Include="PalDDD.DependencyInjection.Tests"/>
  </ItemGroup>
</Project>
