<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>PalDDD.Dapper.PostgreSql</RootNamespace>
    <IsAotCompatible>true</IsAotCompatible>
    <IsTrimmable>true</IsTrimmable>
    <Description>Pal.DDD PostgreSQL 增强扩展包（⚠️ AOT 假象：Dapper 反射路径 + NoWarn IL3058 声明兼容，详见母包说明）</Description>
    <NoWarn>$(NoWarn);IL3058;CS1591;CS1573</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Npgsql" />
    <ProjectReference Include="..\PalDDD.Dapper\PalDDD.Dapper.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="PalDDD.Integration.Tests" />
  </ItemGroup>

</Project>
