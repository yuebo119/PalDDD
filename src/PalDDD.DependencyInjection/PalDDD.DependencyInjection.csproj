<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>PalDDD.DependencyInjection</RootNamespace>
    <!-- IL3058: ZLogger 传递分析器警告 -->
    <!-- v16 P2-5 声明：本项目无 IsAotCompatible 显式行——继承 Build.props 的 true（CI PalOrmSample
         AOT publish+run 实证 AddPalDDD/AddPalCommandHandler 链路可行）。IL3058 为 ZLogger 传递
         分析器警告，与运行时 AOT 能力无关。 -->
    <NoWarn>$(NoWarn);CA1812;IL3058</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\PalDDD.Core\PalDDD.Core.csproj" />
    <ProjectReference Include="..\PalDDD.Messaging\PalDDD.Messaging.csproj" />
    <ProjectReference Include="..\PalDDD.CQRS\PalDDD.CQRS.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ZLogger" />
    </ItemGroup>

  <ItemGroup><Using Include="PalDDD.CQRS" Alias="CQRS"/><Using Include="PalDDD.Core" Alias="Core"/><Using Include="PalDDD.Messaging" Alias="Message"/></ItemGroup>
</Project>
