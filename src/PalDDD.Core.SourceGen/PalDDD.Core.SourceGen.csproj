<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <IsPackable>true</IsPackable>
    <Description>PalDDD source generators: IdentityGenerator, EnumGenerator, MessageRegistryGenerator.</Description>
    <IsRoslynComponent>true</IsRoslynComponent>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <DevelopmentDependency>true</DevelopmentDependency>
    <IsAotCompatible>false</IsAotCompatible>
    <IsTrimmable>false</IsTrimmable>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <!-- Source generators intentionally implement Roslyn signatures and do not ship user-facing XML documentation. -->
    <!-- 源生成器专用：RS1035(analyzer 文件)/RS2008(资源)/CA1725/NU5128 -->
    <NoWarn>$(NoWarn);RS1035;RS2008;CS1591;CA1725;NU5128</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" PrivateAssets="all" />
  </ItemGroup>

  <!-- 共享源码（链接编译）：与 PalDDD.Analyzers 共用同一份稳定名称谓词，
       避免两包各自维护副本产生漂移（见 ADR 022） -->
  <ItemGroup>
    <Compile Include="..\PalDDD.Shared\StableNameValidation.cs" Link="Shared\StableNameValidation.cs" />
  </ItemGroup>

  <ItemGroup>
    <None Include="$(OutputPath)\$(AssemblyName).dll" Pack="true" PackagePath="analyzers/dotnet/cs" />
  </ItemGroup>

</Project>
