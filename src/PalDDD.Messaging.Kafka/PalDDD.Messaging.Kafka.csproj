<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>PalDDD.Messaging.Kafka</RootNamespace>
    <Description>Pal.DDD Kafka 适配器 — Confluent.Kafka 发布/订阅、幂等默认与消费健康信号（非 AOT 栈）。</Description>
    <IsAotCompatible>false</IsAotCompatible>
    <IsTrimmable>false</IsTrimmable>
    <VerifyReferenceAotCompatibility>false</VerifyReferenceAotCompatibility>
    <NoWarn>$(NoWarn);CS1591;CA2007</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\PalDDD.Messaging\PalDDD.Messaging.csproj" />
    <ProjectReference Include="..\PalDDD.Serialization\PalDDD.Serialization.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Confluent.Kafka" />
  </ItemGroup>

  <!-- CreateHeaders（internal，B-5 按需构造）的空入参/行为锁定测试在 Messaging.Integration.Tests
       （broker 工程单测归属集成侧——领域测试项目不引用 Infra 实现工程，ArchitectureBoundaryTests 门禁） -->
  <ItemGroup>
    <InternalsVisibleTo Include="PalDDD.Messaging.Integration.Tests" />
  </ItemGroup>

</Project>
