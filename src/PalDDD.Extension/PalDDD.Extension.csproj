<Project Sdk="Microsoft.NET.Sdk">

  <!--
    📦 PalDDD.Extension — 扩展聚合元包（仅依赖聚合，无源码）
    ITM-128 修复：①加入 PalDDD.slnx（发布完整性——元包必须被 CI build/pack 覆盖）；
    ②PalDDD.* 依赖改为 ProjectReference——dotnet pack 自动生成带版本的 nuspec 依赖（v72 勘正：去掉写死版本防升版再 stale），
      本地 build 不再要求 NuGet 上已发布同名包；③外部依赖版本随中央版本源（2026-11-22 GA 轮勘正：
      PackageReference 不再带显式 Version，版本由 Directory.Packages.props 单点提供——显式版本在
      rc.3 批次曾漏改造成 NU1605 降级错误，实证第二版本真源不可维护）。

    所有依赖均设 PrivateAssets="build;analyzers"，等价于 nuspec 的
    exclude="Build,Analyzers"：元包仅聚合运行时依赖，不向消费方传递
    build/analyzer 资产。

    本地重建：dotnet pack src/PalDDD.Extension/PalDDD.Extension.csproj
  -->
  <PropertyGroup>
    <Description>Pal.DDD 扩展元包 — 全量 DDD 能力：CQRS + 事件日志 + 幂等 + 投影 + 消息 + 事务 + DI 装配。含非 AOT 的 Transactions（Saga 反射特例），整包不可 AOT。</Description>
    <!-- FIX-019（2026-11-08）：显式传导性覆盖——元包引用 IsAotCompatible=false 的
         Transactions（Saga 反射面），对齐 Hosting/OutboxHealth 的三 false 写法，
         避免 AOT 信号误导消费方。 -->
    <IsAotCompatible>false</IsAotCompatible>
    <IsTrimmable>false</IsTrimmable>
    <VerifyReferenceAotCompatibility>false</VerifyReferenceAotCompatibility>
    <PackageTags>DDD;CQRS;EventSourcing;Outbox;Inbox;Saga;Projections;Idempotency;AOT;.NET11;FullStack</PackageTags>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);NU5128;IL3058</NoWarn>
    <!-- NU5104 项目级抑制已删除（2026-11-22 GA 轮）：其前提「.NET 11 生态只有 preview 依赖可用」
         随 GA 稳定版全批落地消失，全局 NoWarn 的 NU5104 同日清偿（ITM-806 预案第 4 步）。
         元包外部依赖已回归 CPM 中央管理（2026-11-22）：此前 ManagePackageVersionsCentrally=false
         导致显式版本在 rc.3 批次漏改（rc.2/ZLogger 2.5.10 双漂移，NU1605 暴露），根因即第二版本真源。 -->
    <!-- IL3058 项目级抑制（ITM-128/161 配套）：元包聚合的 Transactions 显式非 AOT
         （Saga 反射），其编译期/运行期资产按设计传入；元包自身无源码无运行时。 -->
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\PalDDD.CQRS\PalDDD.CQRS.csproj" PrivateAssets="build;analyzers" />
    <ProjectReference Include="..\PalDDD.DependencyInjection\PalDDD.DependencyInjection.csproj" PrivateAssets="build;analyzers" />
    <ProjectReference Include="..\PalDDD.EventLog\PalDDD.EventLog.csproj" PrivateAssets="build;analyzers" />
    <ProjectReference Include="..\PalDDD.Idempotency\PalDDD.Idempotency.csproj" PrivateAssets="build;analyzers" />
    <ProjectReference Include="..\PalDDD.Messaging\PalDDD.Messaging.csproj" PrivateAssets="build;analyzers" />
    <ProjectReference Include="..\PalDDD.Projections.EventLog\PalDDD.Projections.EventLog.csproj" PrivateAssets="build;analyzers" />
    <ProjectReference Include="..\PalDDD.Projections\PalDDD.Projections.csproj" PrivateAssets="build;analyzers" />
    <ProjectReference Include="..\PalDDD.Transactions\PalDDD.Transactions.csproj" PrivateAssets="build;analyzers" />
    <PackageReference Include="ByteAether.Ulid" PrivateAssets="build;analyzers" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" PrivateAssets="build;analyzers" />
    <PackageReference Include="Microsoft.Extensions.Logging" PrivateAssets="build;analyzers" />
    <PackageReference Include="ZLogger" PrivateAssets="build;analyzers" />
  </ItemGroup>

</Project>
