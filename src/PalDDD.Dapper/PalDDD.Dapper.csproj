<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>PalDDD.Dapper</RootNamespace>
    <IsAotCompatible>true</IsAotCompatible>
    <IsTrimmable>true</IsTrimmable>
    <Description>Pal.DDD Dapper 持久化适配器（⚠️ AOT 假象：[module:DapperAot] 未启用，走经典 Dapper 反射路径；PalORM 适配层提供真 AOT 替代）— 含 Transaction/EventLog/Projection/Repository</Description>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <VerifyReferenceAotCompatibility>false</VerifyReferenceAotCompatibility>
    <NoWarn>$(NoWarn);CA1001;CA2007;CA1062;CA2100;CA2000;CA1849;CA2016;CS1591;CS1573;IL3058;CA2255</NoWarn>
    <!-- Dapper.AOT 1.1.0：铺垫就绪（2026-09-13 探针实证 + 用户裁决"铺垫不动"）。
         二十五轮 A5 勘正二次勘正：旧注释称"1.0.52 的 TypeHandlerAttribute<,> 完整双向面"有误——
         1.1.0 官方证实旧泛型特性从未工作（已 obsolete）；1.1.0 起声明式 [Dapper.TypeHandler]
         生效且自带经典 SqlMapper.TypeHandler shim（基类迁移前置免除，见 DapperAotInitializer.cs）。
         真实启用障碍唯一：ct 只能经 CommandDefinition 传递（直接重载无 ct 参数，探针 CS1739 实证），
         而拦截器只支持直接重载（DAP057）——启用 = 全部调用点改形状 + SQL 执行层 ct 收缩
         （连接超时兜底）。启用动作清单：① [module: DapperAot] 启用 ② 调用点 CommandDefinition→
         直接重载 ③ 删 DapperAotInitializer 运行时注册（声明式接管）④ 移除 NoWarn 的 DAP005
         ⑤ NativeAOT 发布实测。TypeHandler 经 [ModuleInitializer] 注册，经典 Dapper 运行时路径生效；
         Ulid/Guid/DateTimeOffset 参数已通过 ToSqliteParameter() 手动转为 string。 -->
    <InterceptorsPreviewNamespaces>$(InterceptorsPreviewNamespaces);Dapper.AOT</InterceptorsPreviewNamespaces>
    <InterceptorsNamespaces>$(InterceptorsNamespaces);Dapper.AOT</InterceptorsNamespaces>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Dapper" />
    <PackageReference Include="Dapper.AOT" />
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <PackageReference Include="Npgsql" />
    <PackageReference Include="MySqlConnector" />
    <ProjectReference Include="..\PalDDD.Core\PalDDD.Core.csproj" />
    <ProjectReference Include="..\PalDDD.Transactions\PalDDD.Transactions.csproj" />
    <ProjectReference Include="..\PalDDD.EventLog\PalDDD.EventLog.csproj" />
    <ProjectReference Include="..\PalDDD.Projections\PalDDD.Projections.csproj" />
    <ProjectReference Include="..\PalDDD.Idempotency\PalDDD.Idempotency.csproj" />
  </ItemGroup>

</Project>
