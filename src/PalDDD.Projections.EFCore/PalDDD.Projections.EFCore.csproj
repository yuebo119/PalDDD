<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>PalDDD.Projections</RootNamespace>
    <Description>Pal.DDD 投影的 EF Core 适配器 — 检查点存储（非 AOT 栈）。</Description>
    <IsAotCompatible>false</IsAotCompatible>
    <IsTrimmable>false</IsTrimmable>
    <VerifyReferenceAotCompatibility>false</VerifyReferenceAotCompatibility>
    <NoWarn>$(NoWarn);CA1033;CA2007</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\PalDDD.Projections\PalDDD.Projections.csproj" />
  </ItemGroup>

  <!-- R12 C-03：集成测试直测 IsPositionCastFailure 的 SQLSTATE 分类。 -->
  <ItemGroup><InternalsVisibleTo Include="PalDDD.Integration.Tests"/></ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
  </ItemGroup>

</Project>
