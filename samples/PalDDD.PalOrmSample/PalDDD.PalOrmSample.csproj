<Project Sdk="Microsoft.NET.Sdk">

  <!--
    PalDDD.PalOrmSample — PalORM Sqlite AOT 发布验证
    ════════════════════════════════════════════════════════════
    目标：用 dotnet publish -r win-x64 /p:PublishAot=true 验证 PalDDD.PalORM Sqlite
          适配器的 Outbox + UnitOfWork 路径 AOT 兼容。
    通过：编译期 0 警告 + 运行时 PASSED 输出。
    失败：任一 IL2026 警告（TreatWarningsAsErrors）直接 error；
          IL3058 引用兼容警告已在本项目 NoWarn 做项目级抑制（ITM-161），不参与失败判定。

    实际覆盖（与 Program.cs 保持一致，不夸大）：
    - Outbox CRUD（AddMessage / GetPendingMessagesAsync / MarkProcessed）
    - SqlitePalOrmUnitOfWork commit / rollback（SQLite 实库）
    未覆盖：Inbox / Saga / EventLog / Projection / Idempotency 等其余 Store。
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>PalDDD.PalOrmSample</RootNamespace>
    <AssemblyName>PalDDD.PalOrmSample</AssemblyName>
    <IsPackable>false</IsPackable>
    <!-- ITM-157：不在 csproj 固定 PublishAot=true——那会让 dotnet build 直接触发
         IL3058 引用兼容检查（Microsoft.Data.Sqlite/Transactions/SQLitePCLRaw 非全 AOT），
         导致 build 0/0 无法达成。AOT 验证按注释使用
         dotnet publish -r win-x64 /p:PublishAot=true 进行。 -->
    <IsAotCompatible>true</IsAotCompatible>
    <IsTrimmable>true</IsTrimmable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
    <!-- AOT 发布时速度优先 -->
    <OptimizationPreference>Speed</OptimizationPreference>
    <StackTraceLineNumberSupport>true</StackTraceLineNumberSupport>
    <!-- Sample 是诊断入口（非生产代码）：允许 Console.WriteLine 硬编码字符串 -->
    <!-- ITM-161：全局 IL3058 已移除；本示例 build 阶段 IsAotCompatible=true 触发引用兼容检查，
         被引用的 Microsoft.Data.Sqlite/Transactions/SQLitePCLRaw 非全 AOT，保留项目级抑制（AOT 验证走 publish） -->
    <NoWarn>$(NoWarn);CA1303;IL3058</NoWarn>
    <!-- 2026-10-17 rc.2 SDK 实证：PublishAot + RID 发布路径下 DocumentationFile 落到非 RID
         目录（net11.0/ 而非 net11.0/<rid>/），publish 复制步骤 MSB3030「找不到文件」红
         （普通 build -r 落点正常、publish 路径异常；增量旧产物会掩盖假绿）。sample 为非发布
         诊断件（IsPackable=false），XML 文档无消费方，关掉生成双修 CI 与本地 publish。 -->
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\PalDDD.PalORM.Sqlite\PalDDD.PalORM.Sqlite.csproj" />
  </ItemGroup>

</Project>
