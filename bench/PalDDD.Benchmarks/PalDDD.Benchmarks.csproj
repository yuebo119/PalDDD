<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <!-- CA1031: verify-persist 的 catch Exception 是验证语义(任何异常=该项 FAIL 记录);
         CA1303:工具项目中文输出;DAP005:基座建表用 raw Dapper 调用未启用 DapperAot(工具非生产);
         CA1812:DI 泛型注册实例化的 handler/behavior 分析器不可见(FeatureBenchmarks 假阳性) -->
    <NoWarn>$(NoWarn);CA1034;CA1822;CA2007;CA1031;CA1303;DAP005;CA1812</NoWarn>
    <!-- RunAnalyzersDuringBuild=false 移除（2026-10-08 审计对齐）：原值使 BDN 0.15.7+ 的
         Roslyn 用法分析器（基准类结构/[Params]/单一 baseline 校验）失效；NoWarn 清单已显式
         豁免工具项目噪声，分析器保持开启吃 BDN 诊断面 -->
    <!-- Benchmarks 不需要 AOT -->
    <IsAotCompatible>false</IsAotCompatible>
    <IsTrimmable>false</IsTrimmable>
    <VerifyReferenceAotCompatibility>false</VerifyReferenceAotCompatibility>
    <JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
  </PropertyGroup>

  <ItemGroup>
    <!-- SMP-104 原注释（移除零使用引用）2026-10-08 部分翻案：CQRS/Serialization/
         DependencyInjection 随 app 车道（DispatcherBenchmarks/SerializationBenchmarks，
         入口参数见 Program.cs）恢复引用——恢复时点三者均真实使用（grep using 可证）；
         Messaging 仍零使用保持移除。
         Outbox 基准用的 OutboxMessage/InMemoryOutboxStore（InMemoryInboxStore 实际零引用——ITM-286 勘正） -->
    <ProjectReference Include="..\..\src\PalDDD.Core\PalDDD.Core.csproj" />
    <ProjectReference Include="..\..\src\PalDDD.CQRS\PalDDD.CQRS.csproj" />
    <ProjectReference Include="..\..\src\PalDDD.DependencyInjection\PalDDD.DependencyInjection.csproj" />
    <ProjectReference Include="..\..\src\PalDDD.Serialization\PalDDD.Serialization.csproj" />
    <ProjectReference Include="..\..\src\PalDDD.Compression\PalDDD.Compression.csproj" />
    <ProjectReference Include="..\..\src\PalDDD.Compression.Native\PalDDD.Compression.Native.csproj" />
    <ProjectReference Include="..\..\src\PalDDD.Projections\PalDDD.Projections.csproj" />
    <ProjectReference Include="..\..\src\PalDDD.Serialization.Evolution\PalDDD.Serialization.Evolution.csproj" />
    <ProjectReference Include="..\..\src\PalDDD.Hosting.AspNetCore\PalDDD.Hosting.AspNetCore.csproj" />
    <ProjectReference Include="..\..\src\PalDDD.Transactions\PalDDD.Transactions.csproj" />
    <ProjectReference Include="..\..\src\PalDDD.EventLog\PalDDD.EventLog.csproj" />
    <ProjectReference Include="..\..\src\PalDDD.Dapper\PalDDD.Dapper.csproj" />
    <ProjectReference Include="..\..\src\PalDDD.PalORM\PalDDD.PalORM.csproj" />
    <ProjectReference Include="..\..\src\PalDDD.PalORM.Sqlite\PalDDD.PalORM.Sqlite.csproj" />
    <ProjectReference Include="..\..\src\PalDDD.Idempotency\PalDDD.Idempotency.csproj" />
    <ProjectReference Include="..\..\src\PalDDD.Transactions.EFCore\PalDDD.Transactions.EFCore.csproj" />
    <ProjectReference Include="..\..\src\PalDDD.EventLog.EFCore\PalDDD.EventLog.EFCore.csproj" />
    <ProjectReference Include="..\..\src\PalDDD.Idempotency.EFCore\PalDDD.Idempotency.EFCore.csproj" />
    <ProjectReference Include="..\..\src\PalDDD.Dapper.PostgreSql\PalDDD.Dapper.PostgreSql.csproj" />
    <ProjectReference Include="..\..\src\PalDDD.Dapper.Sqlite\PalDDD.Dapper.Sqlite.csproj" />
    <!-- 2026-10-08 缺口清单第⑦项：远程方言车道引用——TestEnvironment 镜像单一真源
         （postgres:18-alpine / mysql:8.4 默认），Testing 仅依赖 Core 无包拖带 -->
    <ProjectReference Include="..\..\test\PalDDD.Testing\PalDDD.Testing.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
    <!-- 2026-10-08：Microsoft.Extensions.DependencyInjection 显式引用随 FrameworkReference
         引入被 NU1510 判冗余移除（Framework 自带 DI 抽象面） -->
    <!-- 远程方言车道（persist-pg/persist-mysql 入口）：容器与驱动对齐 dialect-probe -->
    <PackageReference Include="Testcontainers.PostgreSql" />
    <PackageReference Include="Testcontainers.MySql" />
    <PackageReference Include="Npgsql" />
    <PackageReference Include="MySqlConnector" />
    <!-- 2026-10-08 缺口清单第⑥项：Hosting 每请求开销车道需要 ASP.NET Core 抽象面
         （DefaultHttpContext/ApplicationBuilder/RouteEndpoint，FrameworkReference 零包新增） -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

</Project>
