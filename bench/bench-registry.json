{
  "version": 1,
  "note": "Pal.DDD 性能车道与采样档单一真源。Program.cs 用 classes/mode/overrides 选择测量档；eps-run.cs 用 profiles/expectedSeconds/timeoutMinutes/paths 选择与编排车道。改本文件须同步 perf-registry-check 与 docs/review/perf-system-optimization-2026-10-23.md。",
  "targetsSeconds": {
    "gate": 10,
    "standard": 600,
    "full": 2700,
    "remoteSmoke": 300,
    "remoteFull": 5400,
    "strict": 600
  },
  "modes": {
    "alloc": { "warmup": 2, "iterations": 3, "launch": 1, "invocation": 1, "timing": "none" },
    "fixed": { "warmup": 3, "iterations": 9, "launch": 1, "timing": "trend" },
    "fixed-short": { "warmup": 2, "iterations": 5, "launch": 1, "timing": "trend" },
    "auto": { "warmup": 3, "iterationTimeMs": 200, "minIterations": 3, "maxIterations": 5, "launch": 1, "timing": "trend" },
    "medium-lite": { "warmup": 3, "iterations": 5, "launch": 1, "timing": "trend" },
    "tiny": { "warmup": 2, "iterations": 3, "launch": 1, "timing": "trend" },
    "medium": { "warmup": 10, "iterations": 15, "launch": 2, "timing": "reference" },
    "strict": { "warmup": 20, "iterations": 40, "launch": 3, "timing": "reference" }
  },
  "lanes": [
    {
      "name": "smoke",
      "flag": "smoke",
      "purpose": "6 项分配预算门禁，秒级",
      "profiles": ["gate", "standard", "full"],
      "mode": "n/a",
      "timeoutMinutes": 5,
      "remote": false,
      "expectedSeconds": 1,
      "classes": [],
      "paths": []
    },
    {
      "name": "app",
      "flag": "app",
      "purpose": "CQRS 分发与序列化",
      "profiles": ["standard", "full"],
      "mode": "auto",
      "overrides": { "DispatcherBenchmarks": "fixed" },
      "timeoutMinutes": 45,
      "remote": false,
      "expectedSeconds": 25,
      "classes": ["DispatcherBenchmarks", "SerializationBenchmarks"],
      "paths": ["src/PalDDD.CQRS/**", "src/PalDDD.Serialization*/**", "src/PalDDD.Core/**"]
    },
    {
      "name": "framework",
      "flag": "framework",
      "purpose": "领域事件、值对象、SmartEnum、验证、创建",
      "profiles": ["standard", "full"],
      "mode": "auto",
      "timeoutMinutes": 45,
      "remote": false,
      "expectedSeconds": 60,
      "classes": ["EntityDomainEventBenchmarks", "ValueObjectBenchmarks", "SmartEnumBenchmarks", "ValidationBenchmarks", "EntityCreationBenchmarks"],
      "paths": ["src/PalDDD.Core/**", "src/PalDDD.Serialization*/**"]
    },
    {
      "name": "verify-persist",
      "flag": "verify-persist",
      "purpose": "持久化探针自检",
      "profiles": ["full"],
      "mode": "n/a",
      "timeoutMinutes": 5,
      "remote": false,
      "expectedSeconds": 2,
      "classes": [],
      "paths": ["src/PalDDD.Dapper*/**", "src/PalDDD.PalORM*/**"]
    },
    {
      "name": "infra",
      "flag": "infra",
      "purpose": "Outbox、Inbox、EventLog、SagaState、Configuration（Compression 与 SqlGen 已拆到聚焦车道）",
      "profiles": ["standard", "full"],
      "mode": "auto",
      "overrides": { "OutboxThroughputBenchmarks": "medium", "EventLogBenchmarks": "medium" },
      "timeoutMinutes": 45,
      "remote": false,
      "expectedSeconds": 50,
      "classes": ["OutboxThroughputBenchmarks", "InboxThroughputBenchmarks", "EventLogBenchmarks", "SagaStateBenchmarks", "ConfigurationBenchmarks"],
      "paths": ["src/PalDDD.Transactions*/**", "src/PalDDD.Dapper*/**", "src/PalDDD.PalORM*/**", "src/PalDDD.EventLog*/**", "src/PalDDD.Messaging*/**"]
    },
    {
      "name": "coverage",
      "flag": "coverage",
      "purpose": "Projection、消息演化、Specification、端到端、Hosting",
      "profiles": ["standard", "full"],
      "mode": "auto",
      "overrides": { "ProjectionBenchmarks": "fixed" },
      "timeoutMinutes": 45,
      "remote": false,
      "expectedSeconds": 72,
      "classes": ["ProjectionBenchmarks", "MessageEvolutionBenchmarks", "SpecificationBenchmarks", "EndToEndChainBenchmarks", "HostingBenchmarks"],
      "paths": ["src/PalDDD.Core/**", "src/PalDDD.CQRS/**", "src/PalDDD.Projections/**", "src/PalDDD.Hosting.AspNetCore/**", "src/PalDDD.Serialization*/**"]
    },
    {
      "name": "concurrency",
      "flag": "concurrency",
      "purpose": "Outbox 并发租约（零重复不变量每 wave）",
      "profiles": ["standard", "full"],
      "mode": "fixed-short",
      "timeoutMinutes": 45,
      "remote": false,
      "expectedSeconds": 121,
      "classes": ["OutboxConcurrencyInMemoryBenchmarks", "OutboxConcurrencyDapperSqliteBenchmarks"],
      "paths": ["src/PalDDD.Transactions*/**", "src/PalDDD.Dapper*/**"]
    },
    {
      "name": "saga",
      "flag": "saga",
      "purpose": "Saga 编排",
      "profiles": ["standard", "full"],
      "mode": "auto",
      "timeoutMinutes": 45,
      "remote": false,
      "expectedSeconds": 2,
      "classes": ["SagaLaneBenchmarks"],
      "paths": ["src/PalDDD.Transactions/**"]
    },
    {
      "name": "compression",
      "flag": "compression",
      "purpose": "五算法压缩",
      "profiles": ["full"],
      "mode": "auto",
      "timeoutMinutes": 45,
      "remote": false,
      "expectedSeconds": 38,
      "classes": ["CompressionBenchmarks"],
      "paths": ["src/PalDDD.Compression*/**"]
    },
    {
      "name": "persist",
      "flag": "persist",
      "purpose": "SQLite 三栈持久化",
      "profiles": ["standard", "full"],
      "mode": "medium",
      "timeoutMinutes": 45,
      "remote": false,
      "expectedSeconds": 30,
      "classes": ["DapperPersistenceBenchmarks", "PalOrmPersistenceBenchmarks", "EfCorePersistenceBenchmarks"],
      "paths": ["src/PalDDD.Transactions*/**", "src/PalDDD.Dapper*/**", "src/PalDDD.PalORM*/**", "src/PalDDD.Transactions.EFCore/**"]
    },
    {
      "name": "persist-medium",
      "flag": "persist-medium",
      "purpose": "SQLite 租约锚（persist 的子集，仅聚焦入口）",
      "profiles": [],
      "mode": "medium",
      "filter": ["Outbox_Lease_Batch100"],
      "timeoutMinutes": 45,
      "remote": false,
      "expectedSeconds": 16,
      "classes": ["DapperPersistenceBenchmarks", "PalOrmPersistenceBenchmarks", "EfCorePersistenceBenchmarks"],
      "paths": []
    },
    {
      "name": "persist-mark",
      "flag": "persist-mark",
      "purpose": "标记段成本",
      "profiles": ["standard", "full"],
      "mode": "medium",
      "timeoutMinutes": 45,
      "remote": false,
      "expectedSeconds": 25,
      "classes": ["OutboxMarkPathBenchmarks"],
      "paths": ["src/PalDDD.Transactions*/**", "src/PalDDD.Dapper*/**"]
    },
    {
      "name": "stream",
      "flag": "stream",
      "purpose": "SSE 流式读",
      "profiles": ["standard", "full"],
      "mode": "fixed",
      "timeoutMinutes": 45,
      "remote": false,
      "expectedSeconds": 127,
      "classes": ["StreamReadBenchmarks"],
      "paths": ["src/PalDDD.Core/**", "src/PalDDD.Serialization*/**", "src/PalDDD.Hosting.AspNetCore/**"]
    },
    {
      "name": "delivery",
      "flag": "delivery",
      "purpose": "投递排空与节奏（RTT 矩阵）",
      "profiles": ["full"],
      "mode": "medium-lite",
      "timeoutMinutes": 45,
      "remote": false,
      "expectedSeconds": 906,
      "classes": ["OutboxDeliveryDrainBenchmarks", "OutboxDeliveryCadenceBenchmarks"],
      "paths": ["src/PalDDD.Transactions*/**", "src/PalDDD.Dapper*/**", "src/PalDDD.Messaging*/**", "src/PalDDD.Serialization*/**"]
    },
    {
      "name": "qps",
      "flag": "qps",
      "purpose": "绝对 QPS harness（非 BDN）",
      "profiles": ["full"],
      "mode": "n/a",
      "timeoutMinutes": 10,
      "remote": false,
      "expectedSeconds": 59,
      "classes": [],
      "paths": ["src/PalDDD.CQRS/**", "src/PalDDD.Core/**"]
    },
    {
      "name": "compare",
      "flag": "compare",
      "purpose": "MediatR 与 CAP 对比（CAP 需环境变量）",
      "profiles": ["full"],
      "mode": "auto",
      "overrides": { "CapComparisonBenchmarks": "medium" },
      "timeoutMinutes": 45,
      "remote": false,
      "expectedSeconds": 10,
      "classes": ["MediatRComparisonBenchmarks", "CapComparisonBenchmarks"],
      "paths": ["src/PalDDD.Core/**", "src/PalDDD.CQRS/**", "src/PalDDD.Serialization*/**"]
    },
    {
      "name": "sqlgen",
      "flag": "sqlgen",
      "purpose": "SQLite FTS/JSON SQL 生成（分配判定）",
      "profiles": ["full"],
      "mode": "alloc",
      "timeoutMinutes": 45,
      "remote": false,
      "expectedSeconds": 9,
      "classes": ["SqlGenBenchmarks"],
      "paths": ["src/PalDDD.Dapper*/**", "src/PalDDD.PalORM*/**"]
    },
    {
      "name": "persist-pg",
      "flag": "persist-pg",
      "purpose": "PG 真库吞吐、并发、PalORM、方言特性",
      "profiles": ["remote-full"],
      "mode": "medium-lite",
      "timeoutMinutes": 90,
      "remote": true,
      "expectedSeconds": 250,
      "classes": ["DapperRemoteOutboxThroughputBenchmarks", "DapperRemoteOutboxConcurrencyBenchmarks", "PalOrmRemoteOutboxBenchmarks", "PgDialectFeaturesBenchmarks"],
      "paths": []
    },
    {
      "name": "persist-mysql",
      "flag": "persist-mysql",
      "purpose": "MySQL 真库吞吐、并发、PalORM、SKIP LOCKED 形态",
      "profiles": ["remote-full"],
      "mode": "medium-lite",
      "timeoutMinutes": 90,
      "remote": true,
      "expectedSeconds": 670,
      "classes": ["DapperRemoteOutboxThroughputBenchmarks", "DapperRemoteOutboxConcurrencyBenchmarks", "PalOrmRemoteOutboxBenchmarks", "MySqlSkipLockedShapeBenchmarks"],
      "paths": []
    },
    {
      "name": "delivery-pg",
      "flag": "delivery-pg",
      "purpose": "PG 远程投递排空 A/B",
      "profiles": ["remote-full"],
      "mode": "medium-lite",
      "overrides": { "OutboxDeliveryRemoteAutoDrainBenchmarks": "tiny" },
      "timeoutMinutes": 90,
      "remote": true,
      "expectedSeconds": 577,
      "classes": ["OutboxDeliveryRemoteDrainBenchmarks", "OutboxDeliveryRemoteAutoDrainBenchmarks"],
      "paths": []
    },
    {
      "name": "delivery-mysql",
      "flag": "delivery-mysql",
      "purpose": "MySQL 远程投递排空 A/B",
      "profiles": ["remote-full"],
      "mode": "medium-lite",
      "overrides": { "OutboxDeliveryRemoteAutoDrainBenchmarks": "tiny" },
      "timeoutMinutes": 90,
      "remote": true,
      "expectedSeconds": 707,
      "classes": ["OutboxDeliveryRemoteDrainBenchmarks", "OutboxDeliveryRemoteAutoDrainBenchmarks"],
      "paths": []
    },
    {
      "name": "remote-smoke-pg",
      "flag": "remote-smoke-pg",
      "purpose": "PG 远程冒烟：两个代表 case",
      "profiles": ["remote-smoke"],
      "mode": "medium-lite",
      "filter": ["Outbox_GetPending_Batch100", "EventLog_AppendSingle"],
      "timeoutMinutes": 10,
      "remote": true,
      "expectedSeconds": 120,
      "classes": ["DapperRemoteOutboxThroughputBenchmarks"],
      "paths": []
    },
    {
      "name": "remote-smoke-mysql",
      "flag": "remote-smoke-mysql",
      "purpose": "MySQL 远程冒烟：两个代表 case",
      "profiles": ["remote-smoke"],
      "mode": "medium-lite",
      "filter": ["Outbox_GetPending_Batch100", "EventLog_AppendSingle"],
      "timeoutMinutes": 10,
      "remote": true,
      "expectedSeconds": 180,
      "classes": ["DapperRemoteOutboxThroughputBenchmarks"],
      "paths": []
