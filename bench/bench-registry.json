    {
      "name": "strict-core",
      "flag": "strict-core",
      "purpose": "参考数字严格档（OutboxThroughput + SmartEnum）",
      "profiles": ["strict"],
      "mode": "strict",
      "timeoutMinutes": 30,
      "remote": false,
      "expectedSeconds": 180,
