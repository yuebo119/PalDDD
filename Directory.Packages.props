<Project>

<!-- 中央包管理 — 统一 NuGet 版本（.NET 11 RC1 线；2026-09-10 全量升级：微软官方包/传递钉扎升至 11.0.0-rc.1.26425.128，第三方升最新稳定版；
       2026-09-25 增量升位：PalORM ×5 → 5.6.0、SqlClient → 7.1.0；Verify.TUnit 按 2026-09-23 裁决停 32.x，BDN/Unsafe 仅 preview 不升） -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup>
    <!-- 源码生成器（仅编译时，不传递到用户项目） -->
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="5.9.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.Analyzers" Version="5.9.0" />
    <!-- 仓储层依赖 (EF Core 11 RC1) — 多数据库 Provider -->
    <!-- 2026-09-13 版本核实:EF Core 11 线最新即 rc.1.26425.128(rc.2 未发,GA 预计 2026-11),
         本仓已在最新版;死条目清理:SqlServer/Design/Npgsql.EF(11.0.0-preview.6)/Pomelo(11.0.0-preview.5)
         四包零直接引用 + 全解决方案 include-transitive 传递图零命中,删除(区别于二十五轮误删案:
         该案为活传递钉扎,本案 include-transitive 实锤) -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="11.0.0-rc.1.26425.128" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.InMemory" Version="11.0.0-rc.1.26425.128" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="11.0.0-rc.1.26425.128" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="11.0.0-rc.1.26425.128" />
    <!-- DI 扩展依赖 (.NET 11 RC1) — 这些包在 net11.0 下自动可用，csproj 中不再显式引用 -->
    <PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="11.0.0-rc.1.26425.128" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="11.0.0-rc.1.26425.128" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="11.0.0-rc.1.26425.128" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="11.0.0-rc.1.26425.128" />
    <PackageVersion Include="Microsoft.Extensions.Logging" Version="11.0.0-rc.1.26425.128" />
    <!-- ZLogger — 零分配结构化日志（构建于 M.E.Logging 之上） -->
    <PackageVersion Include="ZLogger" Version="2.5.10" />
    <!-- ByteAether.Ulid — 时间排序唯一标识符（AOT 兼容 · RFC 9562 合规） -->
    <PackageVersion Include="ByteAether.Ulid" Version="1.4.1" />
    <!-- Dapper 适配器 — SQLite / PostgreSQL / MySQL（AOT 兼容）。2.1.86（ITM-809，2026-09-19 补丁级升级） -->
    <PackageVersion Include="Dapper" Version="2.1.89" />
    <!-- Dapper.AOT 1.1.0（2026-09-13 升级探针实证）：拦截器接线在 .NET 11 已恢复（1.0.52 的
         InterceptsLocation(line,char) 旧形式失效指控对 1.1.0 不成立——net11 SDK JIT 堆栈走生成代码
         + NativeAOT 二进制实跑全绿）；TypeHandler 声明式 [Dapper.TypeHandler] 生效（含经典
         SqlMapper.TypeHandler shim）；CommandDefinition 拼写照 DAP057 拒绝（与 ct 传参互斥，
         2026-09-13 用户裁决"铺垫不动"，启用路径见 DapperAotInitializer.cs 头注） -->
    <PackageVersion Include="Dapper.AOT" Version="1.1.0" />
    <!-- PalORM 适配器 — 面向 Native AOT 的 .NET 11 微 ORM（源生成 + 编译期 SQL，真 AOT 安全）
         5.6.0 性能轮（2026-09-24 发布）：SemVer Minor、CHANGELOG 声明无破坏性变更，产品包依赖面零变化。
         两处行为微变经本仓核实不命中：① InsertAsync 显式主键且全列可插时改返回传入实体同一引用——
         本仓两处消费点（PalOrmOutboxStore.AddMessage 丢弃返回值、PalOrmEventLog 走自增主键回填路径）
         均不依赖"物化新实例"，且全测试零 InsertAsync 返回值断言；② CommandSqlSet.Insert 字段恢复
         发射——本仓 grep CommandSqlSet 零命中 -->
    <PackageVersion Include="PalORM.Core" Version="5.6.0" />
    <PackageVersion Include="PalORM.SourceGen" Version="5.6.0" />
    <PackageVersion Include="PalORM.Sqlite" Version="5.6.0" />
    <PackageVersion Include="PalORM.PostgreSql" Version="5.6.0" />
    <PackageVersion Include="PalORM.MySql" Version="5.6.0" />
    <!-- MemoryPack 二进制序列化（AOT 兼容） -->
    <PackageVersion Include="MemoryPack" Version="1.21.4" />
    <!-- Dapper.FluentMap 已移除 — 改用 Dapper.DefaultTypeMap.MatchNamesWithUnderscores -->
    <!-- SqlKata 已移除 — 改用 DapperDbType 枚举分发 SQL 方言，零依赖 -->
    <!-- SqlClient 7.1.0（2026-09-25 升位）：原停 7.0.2 的理由是 7.1.0-preview3 build 26238 早于 RC1
         26425 属过时 preview 线，7.0.2 即最新稳定——7.1.0 已于 2026-09-18 转稳定发布，该理由失效。
         注：本条为零引用中央声明（全仓无 PackageReference 消费，见 ITM-711），升位只影响声明版本 -->
    <PackageVersion Include="Microsoft.Data.SqlClient" Version="7.1.0" />
    <PackageVersion Include="Microsoft.Data.Sqlite" Version="11.0.0-rc.1.26425.128" />
    <!-- SQLite 引擎（传递依赖显式固定，确保构建可重现） -->
    <PackageVersion Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />
    <PackageVersion Include="SQLitePCLRaw.core" Version="3.0.5" />
    <PackageVersion Include="Npgsql" Version="10.0.3" />
    <PackageVersion Include="MySqlConnector" Version="2.6.2" />
    <PackageVersion Include="Microsoft.Extensions.Options" Version="11.0.0-rc.1.26425.128" />
    <!-- 消息代理适配器（可选） -->
    <PackageVersion Include="RabbitMQ.Client" Version="7.2.2" />
    <PackageVersion Include="Confluent.Kafka" Version="2.15.1" />
    <!-- 测试基础设施 — TUnit（源生成器测试框架 · MTP） -->
    <PackageVersion Include="TUnit" Version="1.69.0" />
    <PackageVersion Include="BenchmarkDotNet" Version="0.15.8" />
    <!-- 属性测试 — FsCheck + TUnit 集成 -->
    <PackageVersion Include="FsCheck" Version="3.4.0" />
    <PackageVersion Include="TUnit.FsCheck" Version="1.69.0" />
    <!-- 快照测试 — Verify + TUnit 集成 -->
    <PackageVersion Include="Verify.TUnit" Version="32.0.1" />
    <!-- 集成测试 — Testcontainers -->
    <PackageVersion Include="Testcontainers.Kafka" Version="4.15.0" />
    <PackageVersion Include="Testcontainers.RabbitMq" Version="4.15.0" />
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.15.0" />
    <PackageVersion Include="Testcontainers.MySql" Version="4.15.0" />

    <!-- 传递依赖版本覆盖 — System 包最新版本 -->
    <!-- P2 恢复（二十六轮验证轮 W2）：下列五条是 CentralPackageTransitivePinningEnabled=true 激活的
         活传递钉扎（include-transitive 实证：RabbitMQ.Client 依赖 RateLimiting、Roslyn 链依赖
         CodePages/Humanizer、BenchmarkDotNet 依赖 CodeDom/Management）。二十五轮误判为死条目删除，
         致 7 项目传递依赖回退 1-2 个主版本。教训：CPM 死条目判定必须查传递图，
         仅 grep 直接引用在传递钉扎开启时不充分 -->
    <PackageVersion Include="System.Threading.RateLimiting" Version="11.0.0-rc.1.26425.128" />
    <PackageVersion Include="System.Text.Encoding.CodePages" Version="11.0.0-rc.1.26425.128" />
    <PackageVersion Include="System.CodeDom" Version="11.0.0-rc.1.26425.128" />
    <PackageVersion Include="System.Management" Version="11.0.0-rc.1.26425.128" />
    <PackageVersion Include="Humanizer.Core" Version="3.0.10" />
    <PackageVersion Include="System.Collections.Immutable" Version="11.0.0-rc.1.26425.128" />
    <PackageVersion Include="System.Buffers" Version="4.6.1" />
    <PackageVersion Include="System.Memory" Version="4.6.3" />
    <PackageVersion Include="System.Numerics.Vectors" Version="4.6.1" />
    <PackageVersion Include="System.Runtime.CompilerServices.Unsafe" Version="6.1.2" />
    <PackageVersion Include="System.Threading.Tasks.Extensions" Version="4.6.3" />
    <PackageVersion Include="Microsoft.Bcl.AsyncInterfaces" Version="11.0.0-rc.1.26425.128" />
    <!-- Platforms 包 8.0 后停更（2026-09-10 restore 实测 NU1102 证实：最新即 8.0.0-preview.7.23375.6，勿再升） -->
    <PackageVersion Include="Microsoft.NETCore.Platforms" Version="8.0.0-preview.7.23375.6" />
    <!-- 传递依赖版本固定 — 覆盖过时的传递依赖 -->
    <PackageVersion Include="System.Reflection.Metadata" Version="11.0.0-rc.1.26425.128" />
    <!-- 原生压缩绑定 — LZ4 / ZStandard (Cysharp)。NativeCompressions.OpenZL 已移除（八轮评审：零使用的死依赖） -->
    <PackageVersion Include="NativeCompressions" Version="0.6.1" />
  </ItemGroup>
</Project>