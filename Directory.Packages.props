  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup>
    <!-- 源码生成器（仅编译时，不传递到用户项目） -->
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="5.9.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.Analyzers" Version="5.9.0" />
    <!-- 第三方代码质量分析器（2026-10-18 接入，PrivateAssets=all，不进包依赖） -->
    <PackageVersion Include="Roslynator.Analyzers" Version="5.0.1" />
    <PackageVersion Include="Meziantou.Analyzer" Version="3.0.317" />
    <PackageVersion Include="SonarAnalyzer.CSharp" Version="10.35.0.4138" />
    <!-- 仓储层依赖 (EF Core 11 rc.3 线) — 多数据库 Provider -->
    <!-- 2026-09-13 版本核实:EF Core 11 线最新即 rc.1.26425.128(rc.2 未发,GA 预计 2026-11),
         本仓已在最新版;死条目清理:SqlServer/Design/Npgsql.EF(11.0.0-preview.6)/Pomelo 11.x
         （NuGet 无此版本；EF 11 预览由社区 fork Microting.EntityFrameworkCore.MySql 11.0.0-preview.1
          提供，2026-10-20 已在 EF Core rc2 + MySQL 8.4.11 通过 8/8 烟测）
         四包零直接引用 + 全解决方案 include-transitive 传递图零命中,删除(区别于二十五轮误删案:
         该案为活传递钉扎,本案 include-transitive 实锤)；2026-10-11 三升 rc.2 已发（26504.105 批，
         全钉扎同批，flatcontainer 逐包验证后替换） -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="11.0.0-rc.3.26522.148" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.InMemory" Version="11.0.0-rc.3.26522.148" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="11.0.0-rc.3.26522.148" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="11.0.0-rc.3.26522.148" />
    <!-- DI 扩展依赖 (.NET 11 rc.3) — 这些包在 net11.0 下自动可用，csproj 中不再显式引用 -->
    <PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="11.0.0-rc.3.26522.148" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="11.0.0-rc.3.26522.148" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="11.0.0-rc.3.26522.148" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="11.0.0-rc.3.26522.148" />
    <PackageVersion Include="Microsoft.Extensions.Logging" Version="11.0.0-rc.3.26522.148" />
    <!-- ZLogger — 零分配结构化日志（构建于 M.E.Logging 之上） -->
    <PackageVersion Include="ZLogger" Version="2.5.10" />
    <!-- ByteAether.Ulid — 时间排序唯一标识符（AOT 兼容 · RFC 9562 合规） -->
    <PackageVersion Include="ByteAether.Ulid" Version="1.4.2" />
    <!-- Dapper 适配器 — SQLite / PostgreSQL / MySQL（AOT 兼容）。2.1.86（ITM-809，2026-09-19 补丁级升级） -->
    <PackageVersion Include="Dapper" Version="2.1.89" />
    <!-- Dapper.AOT 1.1.0（2026-09-13 升级探针实证）：拦截器接线在 .NET 11 已恢复（1.0.52 的
         InterceptsLocation(line,char) 旧形式失效指控对 1.1.0 不成立——net11 SDK JIT 堆栈走生成代码
         + NativeAOT 二进制实跑全绿）；TypeHandler 声明式 [Dapper.TypeHandler] 生效（含经典
         SqlMapper.TypeHandler shim）；CommandDefinition 拼写照 DAP057 拒绝（与 ct 传参互斥，
         2026-09-13 用户裁决"铺垫不动"，启用路径见 DapperAotInitializer.cs 头注） -->
    <PackageVersion Include="Dapper.AOT" Version="1.1.0" />
    <!-- PalORM 适配器 — 面向 Native AOT 的 .NET 11 微 ORM（源生成 + 编译期 SQL，真 AOT 安全）
         6.8.0（2026-10-26 升位，次版本线 6.7.0 → 6.8.0）：上游协议 AGPL-3.0-only → Apache-2.0
         （Apache-2.0 宽松于本仓 AGPL-3.0-or-later，引用方向兼容）；行为变化为 SQLite 批插/批删
         改行预编译与 json_each 单参数形态（批插 3.5~3.9×、批删 15×+）、批内重复主键后行覆盖
         前行、混合类型键批删在 JSON 构建期抛 FormatException——本仓 Outbox/Inbox 主键 Ulid
         无批内重复路径，适配面由编译 + PalORM 测试面板与 AOT 双样本实证；6.7.0（2026-10-23）：
         无公共 API 签名变更，TenantAware/QueryPipeline/结构体投影本仓均未消费 -->
    <PackageVersion Include="PalORM.Core" Version="6.8.0" />
    <PackageVersion Include="PalORM.SourceGen" Version="6.8.0" />
    <PackageVersion Include="PalORM.Sqlite" Version="6.8.0" />
    <PackageVersion Include="PalORM.PostgreSql" Version="6.8.0" />
    <PackageVersion Include="PalORM.MySql" Version="6.8.0" />
    <!-- MemoryPack 二进制序列化（AOT 兼容） -->
    <PackageVersion Include="MemoryPack" Version="1.21.4" />
    <!-- Dapper.FluentMap 已移除 — 改用 Dapper.DefaultTypeMap.MatchNamesWithUnderscores -->
    <!-- SqlKata 已移除 — 改用 DapperDbType 枚举分发 SQL 方言，零依赖 -->
    <PackageVersion Include="Microsoft.Data.Sqlite" Version="11.0.0-rc.3.26522.148" />
    <!-- Microsoft.Data.Sqlite.Core 传递钉扎补齐（2026-10-17 核新实证）：EF Core Sqlite
         provider 依赖 Core 包而非 meta 包，未声明时解析停在 rc.1——meta 钉扎不覆盖该 ID，
         与 18 处微软 11 线钉扎的「全量随 rc.2」意图矛盾，补钉扎 -->
    <PackageVersion Include="Microsoft.Data.Sqlite.Core" Version="11.0.0-rc.3.26522.148" />
    <!-- SQLite 引擎（传递依赖显式固定，确保构建可重现） -->
    <PackageVersion Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />
    <PackageVersion Include="SQLitePCLRaw.core" Version="3.0.5" />
    <PackageVersion Include="Npgsql" Version="10.0.3" />
    <!-- 2026-10-09 横向对比轮：bench 对比车道消费——MediatR 锚定 12.x 最后开源线
         （13.0.0 起 Lucky Penny 商业许可，对齐 license-policy「禁商业许可」裁决；
         12.5.0 nuspec 为 Apache-2.0 白名单内）；CAP 全家 MIT。
         2026-10-17 用户裁决「预发布版可入包线」：CAP ×3 10.0.2 → 10.1.0-preview-308323494
         （bench 对比车道专用，nuspec 许可随 gate 复验） -->
    <PackageVersion Include="MediatR" Version="12.5.0" />
    <PackageVersion Include="DotNetCore.CAP" Version="10.1.0-preview-308323494" />
    <PackageVersion Include="DotNetCore.CAP.RabbitMQ" Version="10.1.0-preview-308323494" />
    <PackageVersion Include="DotNetCore.CAP.MySql" Version="10.1.0-preview-308323494" />
    <PackageVersion Include="MySqlConnector" Version="2.6.2" />
    <PackageVersion Include="Microsoft.Extensions.Options" Version="11.0.0-rc.3.26522.148" />
    <!-- 消息代理适配器（可选） -->
    <PackageVersion Include="RabbitMQ.Client" Version="7.2.2" />
    <PackageVersion Include="Confluent.Kafka" Version="2.16.0" />
    <!-- 测试基础设施 — TUnit（源生成器测试框架 · MTP） -->
    <PackageVersion Include="TUnit" Version="1.76.28" />
    <!-- BDN 0.16.0-preview.2（2026-10-17 用户裁决预发布可入包线升位）：0.15.8 起本仓
         因 net11-rc moniker 不识别走 InProcess 显式模式（Program.cs 头注+testing.md §4.1
         实录），0.16 线为 BDN 对 .NET 11 的适配版——默认入口是否恢复实测后定，未恢复则
         InProcess 路径维持（头注同步勘正） -->
    <PackageVersion Include="BenchmarkDotNet" Version="0.16.0-preview.2" />
    <!-- 属性测试 — FsCheck + TUnit 集成（3.6.0：2026-10-23 升位，新增 Index/Range、Memory 系、
         ValueTask 与 Half/Int128/DateOnly 等生成器；测试项目目标 net11.0，不涉及上游 TFM 缩减面） -->
    <PackageVersion Include="FsCheck" Version="3.6.0" />
    <PackageVersion Include="TUnit.FsCheck" Version="1.76.28" />
    <!-- 快照测试 — Verify + TUnit 集成 -->
    <PackageVersion Include="Verify.TUnit" Version="32.0.1" />
    <!-- 集成测试 — Testcontainers -->
    <PackageVersion Include="Testcontainers.Kafka" Version="4.16.0" />
    <PackageVersion Include="Testcontainers.RabbitMq" Version="4.16.0" />
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.16.0" />
    <PackageVersion Include="Testcontainers.MySql" Version="4.16.0" />

    <!-- 传递依赖版本覆盖 — System 包最新版本 -->
    <!-- P2 恢复（二十六轮验证轮 W2）：下列五条是 CentralPackageTransitivePinningEnabled=true 激活的
         活传递钉扎（include-transitive 实证：RabbitMQ.Client 依赖 RateLimiting、Roslyn 链依赖
         CodePages/Humanizer、BenchmarkDotNet 依赖 CodeDom/Management）。二十五轮误判为死条目删除，
         致 7 项目传递依赖回退 1-2 个主版本。教训：CPM 死条目判定必须查传递图，
         仅 grep 直接引用在传递钉扎开启时不充分 -->
    <PackageVersion Include="System.Threading.RateLimiting" Version="11.0.0-rc.3.26522.148" />
    <PackageVersion Include="System.Text.Encoding.CodePages" Version="11.0.0-rc.3.26522.148" />
    <PackageVersion Include="System.CodeDom" Version="11.0.0-rc.3.26522.148" />
    <PackageVersion Include="System.Management" Version="11.0.0-rc.3.26522.148" />
    <PackageVersion Include="Humanizer.Core" Version="3.0.10" />
    <PackageVersion Include="System.Collections.Immutable" Version="11.0.0-rc.3.26522.148" />
    <PackageVersion Include="System.Buffers" Version="4.6.1" />
    <PackageVersion Include="System.Memory" Version="4.6.3" />
    <PackageVersion Include="System.Numerics.Vectors" Version="4.6.1" />
    <PackageVersion Include="System.Runtime.CompilerServices.Unsafe" Version="6.1.2" />
    <PackageVersion Include="System.Threading.Tasks.Extensions" Version="4.6.3" />
    <PackageVersion Include="Microsoft.Bcl.AsyncInterfaces" Version="11.0.0-rc.3.26522.148" />
    <!-- Microsoft.Extensions.DependencyModel 传递钉扎补齐（2026-10-17 核新实证）：TUnit/MTP
         链传递依赖，未声明时解析停在 10.0.10 稳定线——与微软 11 线 rc.2 钉扎集不同批，补钉扎 -->
    <PackageVersion Include="Microsoft.Extensions.DependencyModel" Version="11.0.0-rc.3.26522.148" />
    <!-- Platforms 包 8.0 后停更（2026-09-10 restore 实测 NU1102 证实：最新即 8.0.0-preview.7.23375.6，勿再升） -->
    <PackageVersion Include="Microsoft.NETCore.Platforms" Version="8.0.0-preview.7.23375.6" />
    <!-- 传递依赖版本固定 — 覆盖过时的传递依赖 -->
    <PackageVersion Include="System.Reflection.Metadata" Version="11.0.0-rc.3.26522.148" />
    <!-- .NET 11 波次 System.* 传递钉扎补齐（2026-10-20 核新实证）：下列十一项由 Roslyn Workspaces /
         ZLogger / MTP / BDN-Azure 链引入，未声明时解析停在 4.5.0~10.0.3，与「微软 11 线全量同批」
         意图矛盾；各包均含 netstandard2.0 资产，分析器工程与 net11.0 项目共用 -->
    <PackageVersion Include="System.Composition" Version="11.0.0-rc.3.26522.148" />
    <PackageVersion Include="System.Composition.AttributedModel" Version="11.0.0-rc.3.26522.148" />
    <PackageVersion Include="System.Composition.Convention" Version="11.0.0-rc.3.26522.148" />
    <PackageVersion Include="System.Composition.Hosting" Version="11.0.0-rc.3.26522.148" />
    <PackageVersion Include="System.Composition.Runtime" Version="11.0.0-rc.3.26522.148" />
    <PackageVersion Include="System.Composition.TypedParts" Version="11.0.0-rc.3.26522.148" />
    <PackageVersion Include="System.IO.Pipelines" Version="11.0.0-rc.3.26522.148" />
    <PackageVersion Include="System.Threading.Channels" Version="11.0.0-rc.3.26522.148" />
