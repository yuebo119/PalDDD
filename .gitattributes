# 默认所有文本文件自动规范化行尾符（签入为 CRLF，Windows 标准）
* text=auto eol=crlf

# 明确二进制文件，不做行尾符转换
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.snupkg binary
*.nupkg binary
*.dll binary
*.exe binary
*.pdb binary

# Verify 快照基线：强制 LF + UTF-8（官方推荐）。仓库全局 eol=crlf 会把 Linux checkout
# 的基线也转成 CRLF，Verify 拒绝含 \r 的基线——CI 三失败根因（2026-08-20 自诊断注解实锤）
*.verified.txt text eol=lf working-tree-encoding=UTF-8
*.verified.json text eol=lf working-tree-encoding=UTF-8

# Shell/Python 脚本强制 LF（bash 遇 CRLF 报 invalid option / command not found——
# 仓库级 eol=crlf 曾把 CI Linux checkout 的 .sh 转 CRLF，gate-check.sh line 2 set -euo pipefail
# 即死，2026-08-20 CI 自诊断注解实锤"set: pipefail: invalid option name"）
*.sh text eol=lf
*.py text eol=lf
