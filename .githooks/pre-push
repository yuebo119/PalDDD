#!/bin/bash
# pre-push — ITM-671：推送前校验
# ① main 分支保护（从 .git/hooks/pre-push 迁移——原 hook 因 core.hooksPath
#    指向不存在的 .githooks 目录而死亡，本次修复）
# ② 同步提示（ITM-808：多会话/多批次积压的验证债可见性，信息性）
# ③ gate-lite CI 预览（快速门禁降级路径，~2s）
set -uo pipefail

# ── ① main 分支保护 ──
target=$(git rev-parse --abbrev-ref HEAD 2>/dev/null)
if [ "$target" = "main" ]; then
    # ITM-671 修复：原 `dev_head != main_head` 判断在 merge 后恒真（merge commit ≠ dev commit）
    # → 合并后 push 也被拦。改为 merge-base --is-ancestor：dev 是否已合入 main。
    if ! git merge-base --is-ancestor dev main 2>/dev/null; then
        echo "⛔ dev 未合入 main，请先合并：git checkout main && git merge dev"
        echo "   （如果不需要合并，说明你在 main 上直接做了修改——这是违规的）"
        exit 1
    fi
fi

# ── ② 同步提示（ITM-808，2026-09-19：信息性不阻断）──
# 治「多批次并行开发后长时间不推送」的验证债：本地积压越多，CI（尤其
# aot-verify 真发布）对积压代码的验证缺口越大（首席审计 O-1：曾实测积压 49 提交）。
upstream=$(git rev-parse --abbrev-ref --symbolic-full-name '@{upstream}' 2>/dev/null)
if [ -n "$upstream" ]; then
    _ahead=$(git rev-list --count "$upstream..HEAD" 2>/dev/null || echo 0)
    _behind=$(git rev-list --count "HEAD..$upstream" 2>/dev/null || echo 0)
    [ "$_behind" -gt 0 ] && \
        echo "⚠️  pre-push：本地落后 $upstream $_behind 个提交——推送可能被拒或需先 rebase（多会话并行写冲突风险，open-items O-2）。"
    [ "$_ahead" -ge 10 ] && \
        echo "⚠️  pre-push：本次推送承载 $_ahead 个积压提交——CI（含 aot-verify 真发布）将首次验证这批代码，失败排查面较大；建议日常小批推送。"
fi

# ── ③ gate-lite CI 预览 ──
echo "🔍 gate-lite（CI 降级门禁预览）…"
if ! dotnet run scripts/gate-lite.cs 2>&1; then
    echo "⛔ gate-lite 失败"
    exit 1
fi

echo "✅ pre-push 通过"
exit 0
