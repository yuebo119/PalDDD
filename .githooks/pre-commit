#!/bin/sh
# pre-commit — 启动器（2026-10-08 C# 化：182 行判定逻辑迁 scripts/hook-pre-commit.cs，
# 本文件仅启动。git hook 机制要求可执行文件由 shell 引导——dotnet 无法直接充当 hook；
# 历史与激活说明见 scripts/hook-pre-commit.cs 头注释）。
# 跳过：git commit --no-verify（不推荐——守卫红了说明代码有问题）。
cd "$(git rev-parse --show-toplevel 2>/dev/null)" || exit 1
exec dotnet run scripts/hook-pre-commit.cs
