#!/bin/bash
# pre-commit — ITM-671：提交前自动跑快速防线（MIG-012 后判定层在 dotnet test 里，
# 本 hook 补"提交时强制跑"缺口——此前全部依赖自愿执行）。
# 激活：git config core.hooksPath .githooks（已在仓库配置中）
# 跳过：git commit --no-verify（不推荐——守卫红了说明代码有问题）
set -uo pipefail

ROOT="$(git rev-parse --show-toplevel 2>/dev/null)"
cd "$ROOT" || exit 1

FAIL=0

# ── 暂存集快照（触发条件判定用）──
# 为什么不用 `git diff --cached --name-only | grep -q <pat>`：本文件第 6 行
# `set -o pipefail`，而 `grep -q` 命中即退出并关闭管道，仍在写出的 git 收到
# SIGPIPE（退出 141）→ 管道整体返回 141 → `if` 判假 → 该守卫被静默跳过。
# 改动文件多到超过管道缓冲时必现，也就是最该跑守卫的大提交上失效。
# 改为一次性快照 + bash 内建 glob 匹配：零子进程、无 SIGPIPE 面、少 6 次 git 调用。
NL=$'\n'
STAGED="$(git diff --cached --name-only 2>/dev/null || true)"
STAGED_MDR="$(git diff --cached --name-only --diff-filter=MDR 2>/dev/null || true)"
STAGED_ACMR="$(git diff --cached --name-only --diff-filter=ACMR 2>/dev/null || true)"
ALL="${NL}${STAGED}${NL}"
MDR="${NL}${STAGED_MDR}${NL}"
ACMR="${NL}${STAGED_ACMR}${NL}"

# 任一暂存路径以 $1 结尾（$2 为上述带首尾换行的快照，保证按整行边界匹配）
any_ends_with() { [[ "$2" == *"$1${NL}"* ]]; }

# ── 1. secret-scan（凭据入库拦截，~2s）──
echo "🔒 secret-scan …"
if ! dotnet run scripts/secret-scan.cs 2>&1; then
    echo "⛔ secret-scan 失败——受跟踪文件发现疑似硬编码凭据"
    FAIL=1
fi

# ── 2. encoding-gate（编码一致性，~2s）──
echo "📐 encoding-gate …"
if ! dotnet run scripts/encoding-gate.cs 2>&1; then
    echo "⛔ encoding-gate 失败——CRLF/BOM/mojibake"
    FAIL=1
fi

# ── 2b. verify-ai（V1-V25 系统自检，~2s；仅 .ai 存在时跑）──
# 2026-09-22 T-35：`.ai` 裁决为独立 git 库 ⇒ verify-ai 永不进 CI（其唯一调用点在 ci.yml
# 的 `.ai` 恒假分支内，该分支已随 T-02 删除）。此前它**没有任何自动执行路径**——不在 CI、
# 不在 pre-commit、不在 pre-push，25 项检查全靠人工自愿调用。此处给它真正的执行面：
# 本机存在 .ai 时随每次提交运行（.ai 是独立库，clone 主仓无此目录，故加守卫）。
if [ -d .ai ]; then
    echo "🧭 verify-ai（V1-V25，检测到 .ai）…"
    if ! dotnet run scripts/verify-ai.cs 2>&1; then
        echo "⛔ verify-ai 失败——.ai 系统一致性校验未通过"
        FAIL=1
    fi
fi

# ── 3. guard.cs（8 道守卫 ~22s，仅 .cs 在暂存集时触发——纯文档提交不耗时）──
if any_ends_with ".cs" "$ALL"; then
    echo "🛡 guard.cs（.cs 在暂存集）…"
    if ! dotnet run scripts/guard.cs 2>&1; then
        echo "⛔ guard 失败——守卫测试红"
        FAIL=1
    fi
fi

# ── 4. test-change-guard（只改测试不改 src = 改测试修绿签名；仅 test/ 的
#       修改/删除在暂存集时触发。豁免：ALLOW_TEST_ONLY_CHANGE=1）──
if [[ "$MDR" == *"${NL}test/"* ]]; then
    echo "🧪 test-change-guard（test/ 有改动）…"
    if ! dotnet run scripts/test-change-guard.cs 2>&1; then
        echo "⛔ test-change-guard 拦截——见上方豁免说明"
        FAIL=1
    fi
fi

# ── 4b. new-skip-guard（test/**.cs 新增 Skip 标注 = 以 Skip 修绿的隐性形态，
#        Pal 会话审计 2026-09-25 立法；净增口径，test/**.cs 在暂存集时触发。
#        豁免：ALLOW_NEW_SKIP=1 + 提交信息写理由与到期日）──
if [[ "$ACMR" == *"${NL}test/"*".cs"* ]]; then
    echo "🚫 new-skip-guard（test/ .cs 有改动）…"
    if ! dotnet run scripts/new-skip-guard.cs 2>&1; then
        echo "⛔ new-skip-guard 拦截——新增强 [Skip] 须豁免并写到期日，或改为修 src"
        FAIL=1
    fi
fi

# ── 5. xml-guard（XML 良构性；仅 xml 系扩展名在暂存集时触发 ~2s）──
# 实证来源：21549d3 在 .csproj 注释写入 `--` 致全仓构建失败（MSB4025），
# 而 secret-scan/encoding-gate/guard 均不校验 XML 合法性——该缺口由此关闭。
if any_ends_with ".csproj" "$ACMR" || any_ends_with ".props" "$ACMR" \
    || any_ends_with ".slnx" "$ACMR" || any_ends_with ".targets" "$ACMR" \
    || any_ends_with ".xml" "$ACMR"; then
    echo "📄 xml-guard（xml 系文件有改动）…"
    if ! dotnet run scripts/xml-guard.cs 2>&1; then
        echo "⛔ xml-guard 拦截——XML 非良构，构建会失败"
        FAIL=1
    fi
fi

# ── 6. verify-conventions --quick（V5 TODO 扫描 + V8 prompt 模板结构 +
#       V9 文档命令引用的脚本须存在 + V11 决策文档三必填段与锚点格式；
#       仅 .md 在暂存集时触发 ~3s）──
# V9 来源：MIG-011/012 迁移脚本后文档未收口，该断链类已二次回归（见
# docs/review/rule-placement-audit-2026-09-13.md），故改为机械拦截。
# V11 来源（2026-09-18）：decision-2026-09-17 实证——基准区间上界引用「审计归档」
# 无仓内锚、决策文档不在任何评审触发面；模板 docs/review/DECISION_TEMPLATE.md。
if any_ends_with ".md" "$ACMR"; then
    echo "📘 verify-conventions --quick（.md 在暂存集）…"
    if ! dotnet run scripts/verify-conventions.cs -- --quick 2>&1; then
        echo "⛔ verify-conventions 静态检查未通过"
        FAIL=1
    fi
fi

# ── 7. dapper-param-guard（Dapper 参数枚举直传静态检查；仅 src/PalDDD.Dapper*/
#       入暂存集时触发 ~1s）──
# 来源：CI #94 实证——Dapper.AOT 拦截器把枚举直传驱动，PG 拒绝；本地 SQLite
# 盲区（DialectProbe Skip + 探针未覆盖）致缺陷直达 CI。修复 ddd9f28 后本检查
# 前移到提交期（同型再现即拦，不再等 CI）。
if [[ "$ALL" == *"${NL}src/PalDDD.Dapper"* ]]; then
    echo "🔧 dapper-param-guard（Dapper 源码在暂存集）…"
    if ! dotnet run scripts/dapper-param-guard.cs 2>&1; then
        echo "⛔ dapper-param-guard 失败——匿名参数含枚举直传（改 (int) 强转）"
        FAIL=1
    fi
fi

# ── 8. config-policy（配置文件策略：dependabot 词表/结构 + Directory.Build
#       Exec 构建期副作用；仅 .github/dependabot.yml 或 Directory.Build.* 入
#       暂存时触发 ~2s）──
# 来源1：dependabot groups.update-types 误用 ignore 词表（version-update:semver-*
#   是 ignore 规则的词表）——该 schema 错误只在配置落到默认分支时由 Dependabot
#   配置检查报出，dev 上长期不暴露，直至 main 上失败（两处词表不同，本仓实证）。
# 来源2：Directory.Build.targets 的 ConfigureGitHooks 并发写 .git/config，Exec
#   失败被 ContinueOnError 降级为 MSB3073 警告、release 的 -warnaserror 再升级
#   为错误——v3.1.0 首发发布链当场中断（已修：Target 带 GITHUB_ACTIONS 跳过）。
# 触发用 $ALL（含删除 D）：策略文件被删也触发，门禁 fail-closed 报"须显式裁决"。
if any_ends_with ".github/dependabot.yml" "$ALL" || any_ends_with "Directory.Build.props" "$ALL" \
    || any_ends_with "Directory.Build.targets" "$ALL"; then
    echo "⚙️ config-policy（dependabot/Directory.Build 有改动）…"
    if ! dotnet run scripts/config-policy.cs 2>&1; then
        echo "⛔ config-policy 拦截——dependabot 词表/结构或 Directory.Build Exec 副作用违规"
        FAIL=1
    fi
fi

# ── 9. license-policy（依赖许可策略；仅 Directory.Packages.props 或 *.csproj
#       入暂存时触发 ~3s——触发面即"依赖清单被改动"的那一面）──
# 来源：2026-09-25 裁决「所有引用的库必须是开源的许可，不使用商业许可」。
# 与 2026-09-23 Verify.TUnit 停 32.x 的裁决同源（dependabot ignore 注释 +
# CHANGELOG Dependencies 段）：此前该裁决只活在文档里，升包不会被拦。
# 为什么触发面是包清单：许可由 nuspec 决定，而 nuspec 只随包清单/版本变化。
if any_ends_with "Directory.Packages.props" "$ALL" || any_ends_with ".csproj" "$ALL"; then
    echo "📜 license-policy（包清单有改动）…"
    if ! dotnet run scripts/license-policy.cs 2>&1; then
        echo "⛔ license-policy 拦截——非白名单许可 / 禁令命中 / gap 到期 / 无法判定（见上方明细）"
        FAIL=1
    fi
fi

# ── 10. count-audit（文档计数声明与源码推导一致；仅 README*.md 或 docs/** 入
#       暂存时触发 ~3s——触发面即"写计数声明的那一面"）──
# 来源：2026-09-25 文档清扫实证计数静默漂移（断言点 89→99、ADR 22→24、prompt
#   模板 9→10 等）只能靠 165 次人工工具调用才找全；推导真值门禁化后，改文档时
#   "写了但不真"的声明即在提交期被拦（声明缺失不算错——PD34 去数字化口径）。
# 触发用 $ACMR：删除声明文件无声明可失实，不触发；src 侧漂移由 CI 无条件跑兜底。
if any_ends_with "README.md" "$ACMR" || any_ends_with "README.en.md" "$ACMR" \
    || [[ "$ACMR" == *"${NL}docs/"* ]]; then
    echo "🔢 count-audit（文档计数声明核对）…"
    if ! dotnet run scripts/count-audit.cs 2>&1; then
        echo "⛔ count-audit 拦截——计数声明与推导真值不一致（或推导失败 fail-closed）"
        FAIL=1
    fi
fi

if [ "$FAIL" -ne 0 ]; then
    echo ""
    echo "⛔ pre-commit 拦截——跳过检查：git commit --no-verify（不推荐）"
    exit 1
fi
echo "✅ pre-commit 通过"
exit 0
